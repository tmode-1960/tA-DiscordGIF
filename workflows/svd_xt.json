{
  "1": {
    "inputs": {
      "ckpt_name": "svd_xt.safetensors"
    },
    "class_type": "ImageOnlyCheckpointLoader",
    "_meta": {
      "title": "Load SVD Checkpoint"
    }
  },
  "2": {
    "inputs": {
      "image": "{{IMAGE_FILENAME}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Source Image"
    }
  },
  "3": {
    "inputs": {
      "width": {{WIDTH}},
      "height": {{HEIGHT}},
      "video_frames": {{FRAMES}},
      "motion_bucket_id": {{MOTION_BUCKET}},
      "fps": {{FPS}},
      "augmentation_level": 0.0,
      "clip_vision": [
        "1",
        1
      ],
      "init_image": [
        "2",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "class_type": "SVD_img2vid_Conditioning",
    "_meta": {
      "title": "SVD Conditioning"
    }
  },
  "4": {
    "inputs": {
      "seed": {{SEED}},
      "steps": {{STEPS}},
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "1",
        0
      ],
      "positive": [
        "3",
        0
      ],
      "negative": [
        "3",
        1
      ],
      "latent_image": [
        "3",
        2
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "5": {
    "inputs": {
      "samples": [
        "4",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "6": {
    "inputs": {
      "images": [
        "5",
        0
      ]
    },
    "class_type": "PreviewImage",
    "_meta": {
      "title": "Preview Frames (Temp)"
    }
  }
}
